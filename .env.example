# Copy to .env and fill in what you use. Never commit .env.

# ollama (free, local) or claude
AI_BACKEND=ollama
OLLAMA_MODEL=qwen2.5:3b

# Only for AI_BACKEND=claude. Any Claude model id works; claude-haiku-5-5 costs less.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Speech to text: base.en is quick; small.en hears better and is slower.
WHISPER_MODEL=base.en
# Folder holding kokoro-v1.0.onnx and voices-v1.0.bin (see README); British voices start with b
KOKORO_DIR=
VOICE=bf_emma

# Only for phone_twilio.py
TWILIO_VOICE=Polly.Amy
